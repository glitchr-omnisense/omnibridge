# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the
# debt left by the moves of omnisense/omnibase's plan "omnibase agnostic", to be paid down gradually: the CI
# fails on any other. Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # BaseTag writes omnibase's mapping vocabulary (Base\Mapping) by name, its classes absent on purpose:
        # omnisense/omnibase is no dependency of this package, and AttributeReaderTest asserts that the
        # attributes are read without them (as the Doctrine fixtures beside it are read without doctrine/orm).
        -
            identifier: attribute.notFound
            path: tests/Fixtures/Schema/Vocabulary/*
